{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (iride)",
      "options": {
        "baseURL": "http://iride.local:11434/v1"
      },
      "models": {
        "proactive_analyst:latest": {
          "name": "Ethical Analyst (設計)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "reactive-reviewer:latest": {
          "name": "Solid Reviewer (レビュー)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "coder-persona:latest": {
          "name": "The Coder (実装)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "num_ctx": 32768,
            "think": false,
            "temperature": 0,
            "presence_penalty": 0
          }
        },
        "gemma4:12b-nvfp4-largectx": {
          "name": "Gemma4 Large Context (横断解析)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "proactive_analyst:latest"
}
