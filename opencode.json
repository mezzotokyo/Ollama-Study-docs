{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "name": "Ollama (TA-MBAir.local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.100.203:11434/v1"
      },
      "models": {
        "ta:engineer": {
          "name": "TA Engineer (Coding)",
          "capabilities": {
            "reasoning": {
              "supported": false
            }
          },
          "body": {
            "temperature": 0,
            "presence_penalty": 0,
            "reasoning_effort": "none"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "ta:auditor": {
          "name": "TA Auditor (Review)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "ta:architect": {
          "name": "TA Architect (Analysis)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "ollama/ta:auditor",
  "permissions": [
    { "action": "shell", "resource": "git commit *", "effect": "ask" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" }
  ]
}
